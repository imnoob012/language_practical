<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.forgeon.membermanagement.model.mapper.UserMapper">
	<select id="findAllOrSearch" resultType="com.forgeon.membermanagement.model.entity.User">
		SELECT * FROM users
		<where>
			<if test="i != null and i != ''">
				name LIKE CONCAT('%', #{i}, '%')
			</if>
		</where>
	</select>
	
</mapper>
	
	
	
	
	
